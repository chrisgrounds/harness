cabal-version: 2.2
name: server
version: 1.0.0.2
license: BSD-3-Clause
license-file: LICENSE
copyright: (c) Simon Marlow
author: Simon Marlow
maintainer: Simon Marlow <marlowsd@gmail.com>
stability: stable
homepage: http://www.haskell.org/server/
synopsis: Harness AF_UNIX model and tool server
category: Console, Text
build-type: Simple
data-files: tools/read_file.json, tools/discover.json

executable server
  hs-source-dirs: src
  main-is: server.hs
  ghc-options: -Wall -threaded
  other-modules: OpenAI, Tools, Socket, Paths_server
  autogen-modules: Paths_server
  build-depends:
      base >= 4.2 && < 5
    , core
    , req
    , text
    , network
    , aeson
    , load-env
    , directory
    , bytestring
  default-language: Haskell2010
