cabal-version: 2.2
name: server
version: 1.0.0.2
license: BSD-3-Clause
license-file: LICENSE
copyright: (c) Simon Marlow
author: Simon Marlow
maintainer: Simon Marlow <marlowsd@gmail.com>
stability: stable
homepage: http://www.haskell.org/server/
synopsis: Harness AF_UNIX model and tool server
category: Console, Text
build-type: Simple
data-files: tools/*.json

common shared
  ghc-options: -Wall -Werror=missing-fields -threaded
  build-depends:
      base >= 4.2 && < 5
    , async
    , stm
    , containers
    , core
    , openai-auth
    , req
    , http-client
    , http-types
    , retry
    , http-client-tls
    , jose >= 0.13
    , lens
    , ram
    , crypton
    , base64-bytestring
    , time
    , unix
    , filelock
    , wai
    , warp
    , text
    , network
    , aeson
    , load-env
    , directory
    , bytestring
    , Cabal-syntax
    , filepath
    , process
    , transformers
  default-language: Haskell2010

executable server
  import: shared
  hs-source-dirs: src
  main-is: server.hs
  other-modules: Agent, Anthropic, Decls, Edits, Holey, Inception, OpenAI, Policy, Progress, Project, Prompts, Render, Socket, Tools, Verify, Workspace, Paths_server
  autogen-modules: Paths_server

test-suite server-tests
  import: shared
  type: exitcode-stdio-1.0
  hs-source-dirs: src, test
  main-is: Main.hs
  other-modules: Agent, Anthropic, Decls, Edits, Holey, Inception, OpenAI, Policy, Progress, Project, Prompts, Render, Tools, Verify, Workspace, Paths_server, OpenAITests, SocketTests, Socket, EndToEnd, Properties, ScriptedModel, AgentTests
  autogen-modules: Paths_server
  build-depends: QuickCheck
