cabal-version: 2.2
name: core
version: 0.1.0.0
synopsis: Shared Harness conversation types and Unix socket JSON protocol
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules:
      Core
    , Core.Chat
    , Core.Message
    , Core.Model
    , Core.Role
    , Core.Tool
    , Core.Protocol
  build-depends:
      base >= 4.14 && < 5
    , aeson >= 2.2
    , attoparsec
    , attoparsec-aeson
    , bytestring
    , network
    , text
  ghc-options: -Wall
  default-language: Haskell2010
