cabal-version: 2.2
name: core
version: 0.1.0.0
synopsis: Shared Harness conversation types and Unix socket JSON protocol
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules:
      Core
    , Core.ChangedFile
    , Core.Chat
    , Core.Event
    , Core.Message
    , Core.Model
    , Core.Role
    , Core.Run
    , Core.Tool
    , Core.Protocol
  build-depends:
      base >= 4.14 && < 5
    , aeson >= 2.2
    , attoparsec
    , attoparsec-aeson
    , bytestring
    , network
    , text
  ghc-options: -Wall -Werror=missing-fields
  default-language: Haskell2010

test-suite core-tests
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
      base
    , aeson
    , core
    , QuickCheck
    , text
  ghc-options: -Wall -Werror=missing-fields
  default-language: Haskell2010

test-suite holey-core-run
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: HoleyCoreRunProperties.hs
  build-depends: base, QuickCheck, core, aeson, attoparsec, attoparsec-aeson, bytestring, network, text
  default-language: Haskell2010
  ghc-options: -Wall

test-suite holey-core-changedfile
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: HoleyCoreChangedFileProperties.hs
  build-depends: base, QuickCheck, core, aeson, attoparsec, attoparsec-aeson, bytestring, network, text
  default-language: Haskell2010
  ghc-options: -Wall
