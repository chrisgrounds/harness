cabal-version: 2.2
name: hs-gui-client
version: 0.1.0.0
synopsis: A Dear ImGui desktop interface for Harness
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
data-files: themes/orng.toml
extra-source-files:
    cbits/*.cpp
  , cbits/imgui/*.h
  , cbits/imgui/LICENSE.txt

-- The parts that do not touch the window: the connection to the server,
-- commands, the interface's state and its updates, and the theme palette.
library
  hs-source-dirs: src
  exposed-modules:
      Client
    , Client.Settings
    , Client.Commands
    , Client.Tokens
    , Theme.Palette
    , UI.State
    , UI.Motion
  build-depends:
      base >= 4.14 && < 5
    , bytestring
    , aeson
    , async
    , directory
    , filepath
    , openai-auth
    , containers
    , core
    , network
    , text
    , toml-parser >= 2.0 && < 3
  ghc-options: -Wall -Werror=missing-fields
  default-language: Haskell2010

executable hs-gui-client
  hs-source-dirs: app
  main-is: Main.hs
  other-modules:
      ImGui.Extras
    , Theme
    , UI
    , UI.Appearance
    , UI.Composer
    , UI.Fonts
    , UI.Layout
    , UI.Settings
    , UI.Sidebar
    , UI.Tools
    , UI.Transcript
    , UI.Widgets
    , Paths_hs_gui_client
  autogen-modules: Paths_hs_gui_client
  build-depends:
      base >= 4.14 && < 5
    , hs-gui-client
    , bytestring
    , core
    , dear-imgui == 2.4.1
    , containers
    , directory
    , filepath
    , network
    , sdl2 >= 2.5 && < 2.6
    , stm
    , text
    , system-cxx-std-lib
  -- Dear ImGui calls the bindings leave out, compiled against a copy of the
  -- header dear-imgui 2.4.1 was built from, with its default defines.
  cxx-sources: cbits/imgui_extras.cpp
  include-dirs: cbits/imgui
  cxx-options: -std=c++11 -DIMGUI_USE_WCHAR32 "-DImDrawIdx=unsigned int"
  ghc-options: -Wall -Werror=missing-fields -threaded
  default-language: Haskell2010

test-suite hs-gui-client-tests
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules: MotionTests
  build-depends:
      base
    , hs-gui-client
    , core
    , QuickCheck
    , text
  ghc-options: -Wall -Werror=missing-fields
  default-language: Haskell2010
