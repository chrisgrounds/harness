cabal-version: 2.2
name: hs-tui-client
version: 0.1.0.0
synopsis: A Brick conversation interface for Harness
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple

executable hs-tui-client
  hs-source-dirs: src
  main-is: Main.hs
  other-modules: Client, Console, UI
  build-depends:
      base >= 4.14 && < 5
    , core
    , brick >= 2.0 && < 3
    , bytestring
    , mtl
    , network
    , text
    , vty >= 6
    , vty-crossplatform
  ghc-options: -Wall -threaded
  default-language: Haskell2010
