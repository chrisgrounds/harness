cabal-version: 2.2
name: hs-tui-client
version: 0.1.0.0
synopsis: A Brick conversation interface for Harness
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
data-files: themes/orng.toml

-- The client's modules live in a library so the executable and every
-- property suite share one compiled copy instead of each rebuilding src.
library
  hs-source-dirs: src
  exposed-modules: Client, Client.Commands, Client.Tokens, Console, TerminalWidth, Theme, UI
  other-modules: Paths_hs_tui_client
  autogen-modules: Paths_hs_tui_client
  build-depends:
      base >= 4.14 && < 5
    , aeson
    , core
    , brick >= 2.0 && < 3
    , bytestring
    , containers
    , directory
    , mtl
    , network
    , text
    , toml-parser >= 2.0 && < 3
    , vty >= 6
    , vty-crossplatform
  ghc-options: -Wall -Werror=missing-fields
  default-language: Haskell2010

executable hs-tui-client
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
      base >= 4.14 && < 5
    , hs-tui-client
    , directory
    , network
  ghc-options: -Wall -Werror=missing-fields -threaded
  default-language: Haskell2010

test-suite holey-client-tokens
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: HoleyClientTokensProperties.hs
  build-depends: base, QuickCheck, hs-tui-client, aeson, core, text
  default-language: Haskell2010
  ghc-options: -Wall

test-suite holey-ui
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: HoleyUIProperties.hs
  build-depends: base, QuickCheck, hs-tui-client, aeson, core, text
  default-language: Haskell2010
  ghc-options: -Wall -Werror=missing-fields

test-suite holey-client-commands
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: HoleyClientCommandsProperties.hs
  build-depends: base, QuickCheck, hs-tui-client, aeson, core, text
  default-language: Haskell2010
  ghc-options: -Wall
