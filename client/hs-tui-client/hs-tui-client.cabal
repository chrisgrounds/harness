cabal-version: 2.2
name: hs-tui-client
version: 0.1.0.0
synopsis: A Brick conversation interface for Harness
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
data-files: themes/orng.toml

executable hs-tui-client
  hs-source-dirs: src
  main-is: Main.hs
  other-modules: Client, Console, TerminalWidth, Theme, UI, Paths_hs_tui_client
  autogen-modules: Paths_hs_tui_client
  build-depends:
      base >= 4.14 && < 5
    , aeson
    , core
    , brick >= 2.0 && < 3
    , bytestring
    , containers
    , directory
    , mtl
    , network
    , text
    , toml-parser >= 2.0 && < 3
    , vty >= 6
    , vty-crossplatform
  ghc-options: -Wall -threaded
  default-language: Haskell2010

test-suite holey-ui
  type: exitcode-stdio-1.0
  hs-source-dirs: test, src
  main-is: HoleyUIProperties.hs
  build-depends: base, QuickCheck, aeson, core, brick, bytestring, containers, directory, mtl, network, text, toml-parser, vty, vty-crossplatform
  default-language: Haskell2010
  other-modules: Client, Console, TerminalWidth, Theme, UI, Paths_hs_tui_client
  autogen-modules: Paths_hs_tui_client
