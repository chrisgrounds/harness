cabal-version: 2.2
name: hs-client
version: 0.1.0.0
synopsis: A minimal terminal client for harness
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple

executable hs-client
  hs-source-dirs: src
  main-is: Main.hs
  build-depends:
      base >= 4.14 && < 5
    , aeson >= 2.2
    , attoparsec
    , attoparsec-aeson
    , bytestring
    , haskeline
    , network
    , text
    , transformers
  ghc-options: -Wall -threaded
  default-language: Haskell2010
